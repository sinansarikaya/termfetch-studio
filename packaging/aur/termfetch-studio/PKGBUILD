# Maintainer: Sinan Sarıkaya <sinan@sinansarikaya.com>
pkgname=termfetch-studio
pkgver=2.0.0
pkgrel=1
pkgdesc="Cross-platform terminal customization and Fastfetch theme studio"
arch=('x86_64' 'aarch64')
url="https://github.com/sinansarikaya/termfetch-studio"
license=('MIT')
depends=('gcc-libs' 'glibc' 'fastfetch')
makedepends=('cargo')
optdepends=(
    'kitty: for Kitty Graphics protocol'
    'chafa: for terminal half-block image fallback'
    'ttf-font-nerd: for icon glyphs'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ffc05868ca725fd561506749506a0ec5102ea01970fbf85ae4e2d318f1c749dc')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-targets
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/termfetch-studio" "$pkgdir/usr/bin/termfetch-studio"
    
    # Install bundled assets (preset logos, themes)
    install -d "$pkgdir/usr/share/termfetch-studio"
    cp -r assets "$pkgdir/usr/share/termfetch-studio/"

    # License & Docs
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
